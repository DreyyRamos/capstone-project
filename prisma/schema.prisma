// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserAdmission {
  admission_id  String          @id @unique @default(cuid())
  user_email    String          @unique
  firstName     String
  lastName      String?
  password      String
  profileImage  String?
  id_picture    String?
  bio           String?
  contactNumber String?
  location      String?
  interests     String[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @default(now()) @updatedAt
  status        AdmissionStatus @default(PENDING)
  role          Role            @default(STUDENT)
}

enum AdmissionStatus {
  PENDING
  REJECTED
  APPROVED
}

model ChangeUserRole {
  request_id            String           @id @unique @default(cuid())
  userId                String
  email                 String           @unique
  firstName             String?
  lastName              String?
  profileImage          String?
  currentRole           Role             @default(STUDENT)
  requestedRole         Role
  reason                String           @db.Text
  additionalInformation String?          @db.Text
  status                ChangeRoleStatus @default(PENDING)
  user                  User             @relation(fields: [userId], references: [id])
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @default(now()) @updatedAt
}

enum ChangeRoleStatus {
  PENDING
  REJECTED
  APPROVED
}

model User {
  id                               String                             @id @unique @default(uuid())
  email                            String                             @unique
  firstName                        String?
  lastName                         String?
  password                         String
  profileImage                     String?
  bio                              String?
  contactNumber                    String?
  location                         String?
  interests                        String[]
  id_picture                       String?
  createdAt                        DateTime                           @default(now())
  updatedAt                        DateTime                           @default(now()) @updatedAt
  role                             Role                               @default(STUDENT)
  publications                     Publication[]
  updatedPublications              Publication[]                      @relation("PublicationUpdatedBy")
  notifications                    Notifications[]
  forums                           Forum[]
  pubComments                      PublicationComments[]
  pubLikes                         PublicationLikes[]
  publicationCommentReplies        PublicationCommentReplies[]
  publicationCommentReplyToReplies PublicationCommentReplyToReplies[]

  // Publication Relations
  pubCommentLikes              PublicationCommentLikes[]
  pubCommentReplyLikes         PublicationCommentReplyLikes[]
  pubCommentReplyToRepliesLike PublicationCommentReplyToReplyLikes[]

  // --- Updated Forum Relations ---
  forumComments                  ForumComments[]
  forumLikes                     ForumLikes[]
  forumCommentLikes              ForumCommentLikes[]
  forumCommentReplyLikes         ForumCommentReplyLikes[]
  forumCommentReplies            ForumCommentReplies[]
  forumCommentReplyToReplies     ForumCommentReplyToReplies[]
  forumCommentReplyToRepliesLike ForumCommentReplyToReplyLikes[]

  // Reports
  // Enhanced Reports Relations
  reportsSubmitted Reports[] @relation("UserReports") // Reports this user has submitted
  reportsAgainst   Reports[] @relation("ReportedUser") // Reports made against this user
  reportsReviewed  Reports[] @relation("ReportReviewer") // Reports this user has reviewed

  reputationPoints   Int              @default(0)
  warningPoints      Int              @default(0)
  status             UserStatus       @default(ACTIVE)
  changeRoleRequests ChangeUserRole[]
}

// Simple user status enum
enum UserStatus {
  ACTIVE // 0-2 warnings
  WARNED // 3-4 warnings  
  SUSPENDED // 5-9 warnings (temporary)
  BANNED // 10+ warnings (permanent)
}

enum Role {
  ADMIN
  MODERATOR
  EDITOR
  STUDENT
}

model Notifications {
  notifId      String       @id @default(cuid())
  notifType    String?
  notifTitle   String?
  notifContent String?
  isRead       Boolean      @default(false)
  createdAt    DateTime     @default(now())
  userId       String?
  user         User?        @relation(fields: [userId], references: [id])
  pubNotifId   String?
  publication  Publication? @relation(fields: [pubNotifId], references: [pubId])
  forumNotifId String?
  forum        Forum?       @relation(fields: [forumNotifId], references: [forumId])
  reportId     String?
  reports      Reports?     @relation(fields: [reportId], references: [reportId])
}

model Forum {
  forumId       String          @id @default(cuid())
  topicTitle    String?         @db.VarChar(255)
  description   String?         @db.Text
  authorId      String?
  author        User?           @relation(fields: [authorId], references: [id])
  imageUrl      String?
  tags          String[]
  category      String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  notifications Notifications[]
  reports       Reports[]

  // --- Updated Forum Relations ---
  forumLikes                    ForumLikes[]
  forumComments                 ForumComments[]
  forumCommentLikes             ForumCommentLikes[]
  forumCommentReplyLikes        ForumCommentReplyLikes[]
  forumCommentReplyToReplyLikes ForumCommentReplyToReplyLikes[]
  forumCommentReplies           ForumCommentReplies[]
  ForumCommentReplyToReplies    ForumCommentReplyToReplies[]
}

model ForumComments {
  commentId       String   @id @default(cuid())
  comment_content String?
  forumId         String?
  forum           Forum?   @relation(fields: [forumId], references: [forumId], onDelete: Cascade)
  authorId        String?
  author          User?    @relation(fields: [authorId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relation to first-level replies
  replies           ForumCommentReplies[]
  forumCommentLikes ForumCommentLikes[]   @relation("CommentLikes")

  reports Reports[]
}

model ForumCommentReplies {
  replyId       String  @id @default(cuid())
  reply_content String?

  // Link to parent comment
  commentId String?
  comment   ForumComments? @relation(fields: [commentId], references: [commentId], onDelete: Cascade)

  // Link to child replies (parent -> children)
  children ForumCommentReplyToReplies[]

  reply_authorId String?
  reply_author   User?   @relation(fields: [reply_authorId], references: [id], onDelete: Cascade)

  // Direct link to the main forum post
  forumId                String?
  forum                  Forum?                   @relation(fields: [forumId], references: [forumId])
  forumCommentReplyLikes ForumCommentReplyLikes[]
  reports                Reports[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// New model for second-level replies (replies to replies)
model ForumCommentReplyToReplies {
  replyToReplyId       String  @id @default(cuid())
  replyToReply_content String?

  // Link to parent reply (child -> parent)
  parentReplyId String
  parentReply   ForumCommentReplies @relation(fields: [parentReplyId], references: [replyId], onDelete: Cascade)

  reply_authorId String?
  reply_author   User?   @relation(fields: [reply_authorId], references: [id], onDelete: Cascade)

  // Direct link to the main forum post
  forumId                       String?
  forum                         Forum?                          @relation(fields: [forumId], references: [forumId])
  forumCommentReplyToReplyLikes ForumCommentReplyToReplyLikes[]
  reports                       Reports[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ForumLikes {
  likeId  String  @id @default(cuid())
  forumId String
  userId  String
  isLiked Boolean @default(false)
  forum   Forum   @relation(fields: [forumId], references: [forumId], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([forumId, userId])
}

// 2. Top-level comment likes
model ForumCommentLikes {
  commentLikeId String        @id @default(cuid())
  commentId     String
  userId        String
  isLiked       Boolean       @default(false)
  comment       ForumComments @relation("CommentLikes", fields: [commentId], references: [commentId], onDelete: Cascade)
  forumId       String?
  forum         Forum?        @relation(fields: [forumId], references: [forumId], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id])

  @@unique([commentId, userId])
}

// 3. First-level reply likes
model ForumCommentReplyLikes {
  commentReplyLikeId String              @id @default(cuid())
  replyId            String
  userId             String
  isLiked            Boolean             @default(false)
  reply              ForumCommentReplies @relation(fields: [replyId], references: [replyId], onDelete: Cascade)
  user               User                @relation(fields: [userId], references: [id])
  forumId            String?
  forum              Forum?              @relation(fields: [forumId], references: [forumId], onDelete: Cascade)

  @@unique([replyId, userId])
}

// 4. Second-level (children of replies) likes
model ForumCommentReplyToReplyLikes {
  commentReplyToReplyLikeId String                     @id @default(cuid())
  replyToReplyId            String
  userId                    String
  isLiked                   Boolean                    @default(false)
  replyToReply              ForumCommentReplyToReplies @relation(fields: [replyToReplyId], references: [replyToReplyId], onDelete: Cascade)
  user                      User                       @relation(fields: [userId], references: [id])
  forumId                   String?
  forum                     Forum?                     @relation(fields: [forumId], references: [forumId], onDelete: Cascade)

  @@unique([replyToReplyId, userId])
}

model Publication {
  pubId                            String                                @id @default(cuid())
  title                            String?                               @db.VarChar(255)
  excerpt                          String?                               @db.Text
  content                          String?                               @db.Text
  authorId                         String?
  author                           User?                                 @relation(fields: [authorId], references: [id])
  imageUrl                         String?
  tags                             String[]
  category                         String?
  notification                     Notifications[]
  pubComments                      PublicationComments[]
  pubLikes                         PublicationLikes[]
  status                           PublicationStatus                     @default(DRAFT)
  reports                          Reports[]
  isFeatured                       Boolean                               @default(false)
  createdAt                        DateTime                              @default(now())
  updatedAt                        DateTime                              @updatedAt
  updatedById                      String?
  updatedBy                        User?                                 @relation("PublicationUpdatedBy", fields: [updatedById], references: [id])
  pubCommentsLikes                 PublicationCommentLikes[]
  pubCommentReplyLikes             PublicationCommentReplyLikes[]
  pubCommentsReplies               PublicationCommentReplies[]
  PublicationCommentReplyToReplies PublicationCommentReplyToReplies[]
  pubCommentReplyToReplyLikes      PublicationCommentReplyToReplyLikes[]
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  PENDING_REVIEW
}

model PublicationComments {
  commentId       String       @id @default(cuid())
  comment_content String?
  pubId           String?
  publication     Publication? @relation(fields: [pubId], references: [pubId], onDelete: Cascade)
  authorId        String?
  author          User?        @relation(fields: [authorId], references: [id])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  reports         Reports[]

  replies         PublicationCommentReplies[]
  pubCommentLikes PublicationCommentLikes[]   @relation("PubCommentLikes")
}

model PublicationCommentReplies {
  replyId       String               @id @default(cuid())
  reply_content String?
  commentId     String?
  comment       PublicationComments? @relation(fields: [commentId], references: [commentId], onDelete: Cascade)

  // parent -> children
  children PublicationCommentReplyToReplies[]

  reply_authorId   String?
  reply_author     User?        @relation(fields: [reply_authorId], references: [id], onDelete: Cascade)
  publicationPubId String?
  publication      Publication? @relation(fields: [publicationPubId], references: [pubId])

  pubCommentReplyLikes PublicationCommentReplyLikes[]
  reports              Reports[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PublicationCommentReplyToReplies {
  replyToReplyId       String  @id @default(cuid())
  replyToReply_content String?

  // child -> parent
  parentReplyId String
  parentReply   PublicationCommentReplies @relation(fields: [parentReplyId], references: [replyId], onDelete: Cascade)

  reply_authorId                      String?
  reply_author                        User?                                 @relation(fields: [reply_authorId], references: [id], onDelete: Cascade)
  publicationPubId                    String?
  publication                         Publication?                          @relation(fields: [publicationPubId], references: [pubId])
  publicationCommentReplyToReplyLikes PublicationCommentReplyToReplyLikes[]
  reports                             Reports[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PublicationLikes {
  likeId      String      @id @default(cuid())
  pubId       String
  userId      String
  isLiked     Boolean     @default(false)
  publication Publication @relation(fields: [pubId], references: [pubId], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id])

  @@unique([pubId, userId])
}

model PublicationCommentLikes {
  commentLikeId String              @id @default(cuid())
  commentId     String
  userId        String
  isLiked       Boolean             @default(false)
  comment       PublicationComments @relation("PubCommentLikes", fields: [commentId], references: [commentId], onDelete: Cascade)
  pubId         String?
  pub           Publication?        @relation(fields: [pubId], references: [pubId], onDelete: Cascade)
  user          User                @relation(fields: [userId], references: [id])

  @@unique([commentId, userId])
}

model PublicationCommentReplyLikes {
  commentReplyLikeId String                    @id @default(cuid())
  replyId            String
  userId             String
  isLiked            Boolean                   @default(false)
  reply              PublicationCommentReplies @relation(fields: [replyId], references: [replyId], onDelete: Cascade)
  user               User                      @relation(fields: [userId], references: [id])
  pubId              String?
  pub                Publication?              @relation(fields: [pubId], references: [pubId], onDelete: Cascade)

  @@unique([replyId, userId])
}

model PublicationCommentReplyToReplyLikes {
  commentReplyToReplyLikeId String                           @id @default(cuid())
  replyToReplyId            String
  userId                    String
  isLiked                   Boolean                          @default(false)
  replyToReply              PublicationCommentReplyToReplies @relation(fields: [replyToReplyId], references: [replyToReplyId], onDelete: Cascade)
  user                      User                             @relation(fields: [userId], references: [id])
  pubId                     String?
  pub                       Publication?                     @relation(fields: [pubId], references: [pubId], onDelete: Cascade)

  @@unique([replyToReplyId, userId])
}

model Reports {
  reportId String @id @default(cuid())

  // Basic report information
  reportedContent String // The actual content that was reported
  reportReason    String // Reason for the report
  description     String? // Optional additional description from reporter
  notifications   Notifications[]

  // Reporter information
  reportedById String
  reportedBy   User   @relation("UserReports", fields: [reportedById], references: [id])

  // Reported user information
  reportedUserId String?
  reportedUser   User?   @relation("ReportedUser", fields: [reportedUserId], references: [id])

  // Content type and references - ALL LEVELS
  contentType ContentType // What type of content is being reported

  // Main content references
  forumId     String?
  forum       Forum?       @relation(fields: [forumId], references: [forumId])
  pubId       String?
  publication Publication? @relation(fields: [pubId], references: [pubId])

  // Comment references (both forum and publication)
  forumCommentId String?
  forumComment   ForumComments?       @relation(fields: [forumCommentId], references: [commentId])
  pubCommentId   String?
  pubComment     PublicationComments? @relation(fields: [pubCommentId], references: [commentId])

  // First-level reply references
  forumReplyId String?
  forumReply   ForumCommentReplies?       @relation(fields: [forumReplyId], references: [replyId])
  pubReplyId   String?
  pubReply     PublicationCommentReplies? @relation(fields: [pubReplyId], references: [replyId])

  // Second-level reply references (reply-to-reply / children)
  forumReplyToReplyId String?
  forumReplyToReply   ForumCommentReplyToReplies?       @relation(fields: [forumReplyToReplyId], references: [replyToReplyId])
  pubReplyToReplyId   String?
  pubReplyToReply     PublicationCommentReplyToReplies? @relation(fields: [pubReplyToReplyId], references: [replyToReplyId])

  // Report status and priority
  status   ReportStatus   @default(PENDING)
  priority ReportPriority @default(MEDIUM)

  // Moderation information
  reviewedById   String?
  reviewedBy     User?     @relation("ReportReviewer", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  moderatorNotes String?

  // Resolution information
  actionTaken String?
  resolvedAt  DateTime?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Enums for better type safety
enum ContentType {
  FORUM_POST
  FORUM_COMMENT
  FORUM_REPLY
  FORUM_REPLY_TO_REPLY // Children of replies
  PUBLICATION
  PUBLICATION_COMMENT
  PUBLICATION_REPLY
  PUBLICATION_REPLY_TO_REPLY // Children of replies
}

enum ReportStatus {
  PENDING
  RESTORED
  RESOLVED
  DELETED
}

enum ReportPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
