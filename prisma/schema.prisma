// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                               String                             @id @unique @default(uuid())
  email                            String                             @unique
  firstName                        String?
  lastName                         String?
  password                         String
  profileImage                     String?
  bio                              String?
  contactNumber                    String?
  location                         String?
  interests                        String[]
  createdAt                        DateTime                           @default(now())
  updatedAt                        DateTime                           @default(now()) @updatedAt
  role                             Role[]                             @default([STUDENT])
  publications                     Publication[]
  updatedPublications              Publication[]                      @relation("PublicationUpdatedBy")
  notifications                    Notifications[]
  forums                           Forum[]
  pubComments                      PublicationComments[]
  pubLikes                         PublicationLikes[]
  publicationCommentReplies        PublicationCommentReplies[]
  publicationCommentReplyToReplies PublicationCommentReplyToReplies[]

  // --- Updated Forum Relations ---
  forumComments              ForumComments[]
  forumLikes                 ForumLikes[]
  forumCommentReplies        ForumCommentReplies[]
  forumCommentReplyToReplies ForumCommentReplyToReplies[]
}

enum Role {
  ADMIN
  MODERATOR
  EDITOR
  STUDENT
}

model Publication {
  pubId                            String                             @id @default(cuid())
  title                            String?                            @db.VarChar(255)
  excerpt                          String?                            @db.VarChar(255)
  content                          String?                            @db.VarChar(65535)
  authorId                         String?
  author                           User?                              @relation(fields: [authorId], references: [id])
  imageUrl                         String?
  tags                             String[]
  category                         String?
  notification                     Notifications[]
  pubComments                      PublicationComments[]
  pubLikes                         PublicationLikes[]
  status                           PublicationStatus                  @default(DRAFT)
  isFeatured                       Boolean                            @default(false)
  createdAt                        DateTime                           @default(now())
  updatedAt                        DateTime                           @updatedAt
  updatedById                      String?
  updatedBy                        User?                              @relation("PublicationUpdatedBy", fields: [updatedById], references: [id])
  pubCommentsReplies               PublicationCommentReplies[]
  PublicationCommentReplyToReplies PublicationCommentReplyToReplies[]
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  PENDING_REVIEW
}

model Notifications {
  notifId      String       @id @default(cuid())
  notifTitle   String?
  notifContent String?
  isRead       Boolean      @default(false)
  createdAt    DateTime     @default(now())
  userId       String?
  user         User?        @relation(fields: [userId], references: [id])
  pubNotifId   String?
  publication  Publication? @relation(fields: [pubNotifId], references: [pubId])
  forumNotifId String?
  forum        Forum?       @relation(fields: [forumNotifId], references: [forumId])
}

model Forum {
  forumId       String          @id @default(cuid())
  topicTitle    String?         @db.VarChar(255)
  description   String?         @db.VarChar(65535)
  authorId      String?
  author        User?           @relation(fields: [authorId], references: [id])
  imageUrl      String?
  tags          String[]
  category      String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  notifications Notifications[]

  // --- Updated Forum Relations ---
  forumLikes                 ForumLikes[]
  forumComments              ForumComments[]
  forumCommentReplies        ForumCommentReplies[]
  ForumCommentReplyToReplies ForumCommentReplyToReplies[]
}

model ForumComments {
  commentId       String   @id @default(cuid())
  comment_content String?
  forumId         String?
  forum           Forum?   @relation(fields: [forumId], references: [forumId], onDelete: Cascade)
  authorId        String?
  author          User?    @relation(fields: [authorId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relation to first-level replies
  replies ForumCommentReplies[]
}

model ForumCommentReplies {
  replyId       String  @id @default(cuid())
  reply_content String?

  // Link to parent comment
  commentId String?
  comment   ForumComments? @relation(fields: [commentId], references: [commentId], onDelete: Cascade)

  // Link to child replies (parent -> children)
  children ForumCommentReplyToReplies[]

  reply_authorId String?
  reply_author   User?   @relation(fields: [reply_authorId], references: [id], onDelete: Cascade)

  // Direct link to the main forum post
  forumId String?
  forum   Forum?  @relation(fields: [forumId], references: [forumId])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// New model for second-level replies (replies to replies)
model ForumCommentReplyToReplies {
  replyToReplyId       String  @id @default(cuid())
  replyToReply_content String?

  // Link to parent reply (child -> parent)
  parentReplyId String
  parentReply   ForumCommentReplies @relation(fields: [parentReplyId], references: [replyId], onDelete: Cascade)

  reply_authorId String?
  reply_author   User?   @relation(fields: [reply_authorId], references: [id], onDelete: Cascade)

  // Direct link to the main forum post
  forumId String?
  forum   Forum?  @relation(fields: [forumId], references: [forumId])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ForumLikes {
  likeId  String  @id @default(cuid())
  forumId String
  userId  String
  isLiked Boolean @default(false)
  forum   Forum   @relation(fields: [forumId], references: [forumId], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([forumId, userId])
}

model PublicationComments {
  commentId       String       @id @default(cuid())
  comment_content String?
  pubId           String?
  publication     Publication? @relation(fields: [pubId], references: [pubId], onDelete: Cascade)
  authorId        String?
  author          User?        @relation(fields: [authorId], references: [id])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  replies PublicationCommentReplies[]
}

model PublicationCommentReplies {
  replyId       String               @id @default(cuid())
  reply_content String?
  commentId     String?
  comment       PublicationComments? @relation(fields: [commentId], references: [commentId], onDelete: Cascade)

  // parent -> children
  children PublicationCommentReplyToReplies[]

  reply_authorId   String?
  reply_author     User?        @relation(fields: [reply_authorId], references: [id], onDelete: Cascade)
  publicationPubId String?
  publication      Publication? @relation(fields: [publicationPubId], references: [pubId])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PublicationCommentReplyToReplies {
  replyToReplyId       String  @id @default(cuid())
  replyToReply_content String?

  // child -> parent
  parentReplyId String
  parentReply   PublicationCommentReplies @relation(fields: [parentReplyId], references: [replyId], onDelete: Cascade)

  reply_authorId   String?
  reply_author     User?        @relation(fields: [reply_authorId], references: [id], onDelete: Cascade)
  publicationPubId String?
  publication      Publication? @relation(fields: [publicationPubId], references: [pubId])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PublicationLikes {
  likeId      String      @id @default(cuid())
  pubId       String
  userId      String
  isLiked     Boolean     @default(false)
  publication Publication @relation(fields: [pubId], references: [pubId], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id])

  @@unique([pubId, userId])
}
