// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                               String                             @id @unique @default(uuid())
  email                            String                             @unique
  firstName                        String?
  lastName                         String?
  password                         String
  profileImage                     String?
  bio                              String?
  contactNumber                    String?
  location                         String?
  interests                        String[]
  createdAt                        DateTime                           @default(now())
  updatedAt                        DateTime                           @default(now()) @updatedAt
  role                             Role[]                             @default([STUDENT])
  publications                     Publication[]
  updatedPublications              Publication[]                      @relation("PublicationUpdatedBy")
  notifications                    Notifications[]
  forums                           Forum[]
  pubComments                      PublicationComments[]
  pubLikes                         PublicationLikes[]
  forumReplies                     ForumReplies[]
  forumLikes                       ForumLikes[]
  publicationCommentReplies        PublicationCommentReplies[]
  publicationCommentReplyToReplies PublicationCommentReplyToReplies[]
}

enum Role {
  ADMIN
  MODERATOR
  EDITOR
  STUDENT
}

model Publication {
  pubId                            String                             @id @default(cuid())
  title                            String?                            @db.VarChar(255)
  excerpt                          String?                            @db.VarChar(255)
  content                          String?                            @db.VarChar(65535)
  authorId                         String?
  author                           User?                              @relation(fields: [authorId], references: [id])
  imageUrl                         String?
  tags                             String[]
  category                         String?
  notification                     Notifications[]
  pubComments                      PublicationComments[]
  pubLikes                         PublicationLikes[]
  status                           PublicationStatus                  @default(DRAFT)
  isFeatured                       Boolean                            @default(false)
  createdAt                        DateTime                           @default(now())
  updatedAt                        DateTime                           @updatedAt
  updatedById                      String?
  updatedBy                        User?                              @relation("PublicationUpdatedBy", fields: [updatedById], references: [id])
  pubCommentsReplies               PublicationCommentReplies[]
  PublicationCommentReplyToReplies PublicationCommentReplyToReplies[]
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  PENDING_REVIEW
}

model Notifications {
  notifId      String       @id @default(cuid())
  notifTitle   String?
  notifContent String?
  isRead       Boolean      @default(false)
  createdAt    DateTime     @default(now())
  userId       String?
  user         User?        @relation(fields: [userId], references: [id])
  pubNotifId   String?
  publication  Publication? @relation(fields: [pubNotifId], references: [pubId])
}

model Forum {
  forumId      String         @id @default(cuid())
  topicTitle   String?        @db.VarChar(255)
  description  String?        @db.VarChar(65535)
  authorId     String?
  author       User?          @relation(fields: [authorId], references: [id])
  imageUrl     String?
  tags         String?
  category     String?
  forumReplies ForumReplies[]
  forumLikes   ForumLikes[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model ForumReplies {
  commentId  String   @id @default(cuid())
  forumReply String?
  forumId    String?
  forum      Forum?   @relation(fields: [forumId], references: [forumId], onDelete: Cascade)
  authorId   String?
  author     User?    @relation(fields: [authorId], references: [id])
  createdAt  DateTime @default(now())
}

model ForumLikes {
  likeId  String  @id @default(cuid())
  forumId String
  userId  String
  isLiked Boolean @default(false)
  forum   Forum   @relation(fields: [forumId], references: [forumId], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([forumId, userId])
}

model PublicationComments {
  commentId       String       @id @default(cuid())
  comment_content String?
  pubId           String?
  publication     Publication? @relation(fields: [pubId], references: [pubId], onDelete: Cascade)
  authorId        String?
  author          User?        @relation(fields: [authorId], references: [id])
  createdAt       DateTime     @default(now())

  replies PublicationCommentReplies[]
}

model PublicationCommentReplies {
  replyId       String               @id @default(cuid())
  reply_content String?
  commentId     String?
  comment       PublicationComments? @relation(fields: [commentId], references: [commentId], onDelete: Cascade)

  // parent -> children
  children PublicationCommentReplyToReplies[]

  reply_authorId   String?
  reply_author     User?        @relation(fields: [reply_authorId], references: [id], onDelete: Cascade)
  publicationPubId String?
  publication      Publication? @relation(fields: [publicationPubId], references: [pubId])

  createdAt DateTime @default(now())
}

model PublicationCommentReplyToReplies {
  replyToReplyId       String  @id @default(cuid())
  replyToReply_content String?

  // child -> parent
  parentReplyId String
  parentReply   PublicationCommentReplies @relation(fields: [parentReplyId], references: [replyId], onDelete: Cascade)

  reply_authorId   String?
  reply_author     User?        @relation(fields: [reply_authorId], references: [id], onDelete: Cascade)
  publicationPubId String?
  publication      Publication? @relation(fields: [publicationPubId], references: [pubId])

  createdAt DateTime @default(now())
}

